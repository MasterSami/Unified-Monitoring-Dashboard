# ---------------------------------------------------------------------------
# Unified Monitoring Dashboard — example environment configuration
# Copy this file to `.env` and adjust. Never commit `.env`.
#
# Server connection details (URLs + credentials) live in `servers.yaml`
# (copy from servers.example.yaml), NOT here.
# ---------------------------------------------------------------------------

# Database. SQLite by default (POC). Switch to PostgreSQL for a server deploy,
# e.g. postgresql+psycopg://user:pass@dbhost:5432/dashboard
DATABASE_URL=sqlite:///./dashboard.db

# Background polling interval, in minutes.
POLL_INTERVAL_MINUTES=5

# Which platforms are active. Comma-separated. Disable a platform here
# without touching servers.yaml, e.g. ENABLED_COLLECTORS=zabbix,nnmi
ENABLED_COLLECTORS=zabbix,dynatrace,nnmi

# Load realistic fake data instead of calling real systems. Great for local
# development and demos without VPN access. Set to false against real systems.
MOCK_MODE=true

# TLS verification for outbound HTTPS. Set to false for internal self-signed
# certificates. Can be overridden per-server in servers.yaml (verify_tls).
TLS_VERIFY=false

# Path to the server inventory file (see servers.example.yaml).
SERVERS_CONFIG=servers.yaml

# Default recipient for the Zabbix "Send test mail" button.
TEST_MAIL_TO=you@example.com

# Rows per page in the hosts / alerts tables.
PAGE_SIZE=300

# Show the CSV "Export" buttons. Set to false to disable export everywhere.
ENABLE_EXPORT=true

# Feature flag for the Topology views: NNMi network map + Dynatrace service map,
# each browsable as a table and as an interactive connection graph (see
# TOPOLOGY.md). The feature is fully built; it stays OFF by default so you enable
# it yourself. Set to true to show the "Topology" nav item and start collecting
# topology (on startup, then on a slow interval).
ENABLE_TOPOLOGY=false

# Topology export buttons: NNMi L2 connections as CSV and the Dynatrace unified
# map as a 3-sheet XLSX (Unified_Map / App_to_App / Service_to_Service) — the
# same shape as the provided export files. OFF by default; enable it yourself.
ENABLE_TOPOLOGY_EXPORT=false

# --- SiteScope push ingest ---------------------------------------------------
# Bearer token the SiteScope forwarder must present to POST events to
# /api/v1/ingest/sitescope. Empty (default) DISABLES the endpoint (returns 503).
# Generate a long random token and set it here + in the forwarder's environment.
SITESCOPE_INGEST_TOKEN=
# Caps per ingest request (match the forwarder batch size).
INGEST_MAX_EVENTS=500
INGEST_MAX_BYTES=5000000
