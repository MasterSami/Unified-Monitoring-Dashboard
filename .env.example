# ---------------------------------------------------------------------------
# Unified Monitoring Dashboard — example environment configuration
# Copy this file to `.env` and adjust. Never commit `.env`.
#
# Server connection details (URLs + credentials) live in `servers.yaml`
# (copy from servers.example.yaml), NOT here.
# ---------------------------------------------------------------------------

# Database. SQLite by default (POC). Switch to PostgreSQL for a server deploy,
# e.g. postgresql+psycopg://user:pass@dbhost:5432/dashboard
DATABASE_URL=sqlite:///./dashboard.db

# Background polling interval, in minutes.
POLL_INTERVAL_MINUTES=5

# Which platforms are active. Comma-separated. Disable a platform here
# without touching servers.yaml, e.g. ENABLED_COLLECTORS=zabbix,nnmi
ENABLED_COLLECTORS=zabbix,dynatrace,nnmi

# Load realistic fake data instead of calling real systems. Great for local
# development and demos without VPN access. Set to false against real systems.
MOCK_MODE=true

# TLS verification for outbound HTTPS. Set to false for internal self-signed
# certificates. Can be overridden per-server in servers.yaml (verify_tls).
TLS_VERIFY=false

# Path to the server inventory file (see servers.example.yaml).
SERVERS_CONFIG=servers.yaml

# Default recipient for the Zabbix "Send test mail" button.
TEST_MAIL_TO=you@example.com

# Rows per page in the hosts / alerts tables.
PAGE_SIZE=300

# Show the CSV "Export" buttons. Set to false to disable export everywhere.
ENABLE_EXPORT=true

# How the Zabbix "Send test mail" action sends:
#   ui    - drive the frontend's Test button, so the ZABBIX SERVER sends the mail
#   smtp  - connect to the relay directly from wherever this app runs
#   auto  - try ui first, fall back to smtp (default)
# Use "ui" if you test from home over a VPN: the relay is normally unreachable
# from a laptop on port 25, while the Zabbix server always has a route to it.
# It needs a real user/password in servers.yaml (an API token cannot log into
# the frontend) with a Super admin role.
TEST_MAIL_MODE=auto

# --- Overview presentation ----------------------------------------------------
# The "Hosts by status" strip (Active / Down / Unknown / Disabled) on the
# Overview. Hidden by default: it repeats what Agent Health already shows, and
# the large "unknown" and "disabled" counts read as failures to anyone who does
# not know both are normal states. Set to true to bring the strip back.
SHOW_HOST_STATUS_ROW=false

# Should "Total Active Servers" count only hosts something is actively
# monitoring? Default false: the tile answers "how many servers do we have that
# are running", so it includes hosts Dynatrace discovered without a OneAgent.
# Set true to narrow it to monitored hosts, matching the per-platform card.
ACTIVE_SERVERS_MONITORED_ONLY=false

# Which alerts the "Critical Alerts" tile counts, matched against each tool's
# OWN severity label (comma-separated, case-insensitive). Counting the unified
# 1-5 scale swept in every platform's top tier at once and produced a number
# too large to act on. Leave empty to fall back to unified severity 5.
CRITICAL_ALERT_LABELS=disaster,critical

# Feature flag for the Topology views: NNMi network map + Dynatrace service map,
# each browsable as a table and as an interactive connection graph (see
# TOPOLOGY.md). The feature is fully built; it stays OFF by default so you enable
# it yourself. Set to true to show the "Topology" nav item and start collecting
# topology (on startup, then on a slow interval).
ENABLE_TOPOLOGY=false

# Topology export buttons: NNMi L2 connections as CSV and the Dynatrace unified
# map as a 3-sheet XLSX (Unified_Map / App_to_App / Service_to_Service) — the
# same shape as the provided export files. OFF by default; enable it yourself.
ENABLE_TOPOLOGY_EXPORT=false

# --- Runbook (admin script library) ------------------------------------------
# The team's library of operational scripts, browsable and runnable from the UI.
# OFF by default, exactly like Topology — set this to true to show the nav item.
# See RUNBOOK.md.
ENABLE_RUNBOOK=false

# Who may open the Runbook. ';'-separated "user=<sha256-hex-of-password>" pairs,
# so no readable password is ever stored here. Generate a line with:
#     python -m app.runbook_auth hash
# RUNBOOK_USERS=ahmed=9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08
RUNBOOK_USERS=

# Single-admin convenience fallback (plaintext). Prefer RUNBOOK_USERS.
RUNBOOK_USER=
RUNBOOK_PASSWORD=

# HMAC key signing the Runbook session cookie. Leave empty and a random key is
# generated per process, which ends every session on restart. Set a long random
# value to keep sessions valid across restarts.
RUNBOOK_SECRET=
RUNBOOK_SESSION_MINUTES=60

# Hard cap on rows one Runbook script may return.
RUNBOOK_MAX_ROWS=20000

# Scripts that WRITE to the monitoring tools are documented in the Runbook but
# never runnable from the web UI. Leave this off.
RUNBOOK_ALLOW_WRITE=false

# --- SiteScope push ingest ---------------------------------------------------
# Bearer token the SiteScope forwarder must present to POST events to
# /api/v1/ingest/sitescope. Empty (default) DISABLES the endpoint (returns 503).
# Generate a long random token and set it here + in the forwarder's environment.
SITESCOPE_INGEST_TOKEN=
# Caps per ingest request (match the forwarder batch size).
INGEST_MAX_EVENTS=500
INGEST_MAX_BYTES=5000000

# --- SiteScope LOCAL DEMO (env-only) -----------------------------------------
# Try the whole SiteScope scenario on a laptop with NO forwarder and NO access
# to the SiteScope server. Point this at a REDACTED .tsv on disk (produced by
# deploy/sitescope-forwarder/sitescope_redact_export.ps1) and UMD auto-loads it
# on startup and refreshes it every poll interval — SiteScope then shows as a
# full platform (hosts + alerts). Empty (default) = demo OFF. Leave it empty in
# production and use the on-box forwarder instead.
SITESCOPE_DEMO_FILE=
# Instance label the demo data is filed under (appears in the collector list).
SITESCOPE_DEMO_INSTANCE=SiteScope-141
# Multiple SiteScope servers at once — ';'-separated "Instance=Path" entries
# (Windows drive colons are fine). All are auto-loaded on startup and every
# poll interval. Keep each file fresh on disk to keep its data live.
#   SITESCOPE_DEMO_FILES=SiteScope-141=D:\umd\sis141.tsv;SiteScope-140=D:\umd\sis140.tsv;SiteScope-34=D:\umd\sis34.tsv
SITESCOPE_DEMO_FILES=
